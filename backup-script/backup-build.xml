<?xml version="1.0" encoding="UTF-8"?>
<project name="GIFT-Backup" default="backup" basedir=".">
    
    <description>
        GIFT Data Backup Script
        Backs up data and output folders with timestamp
    </description>
    
    <!-- Configuration Properties -->
    <property name="gift.base.dir" location="C:/GIFT-ASU-EXP/GIFT-ASU/GIFT"/>
    <property name="backup.destination.dir" location="E:\GIFT-BACKUP-DATA"/>
    
    <!-- Create timestamp and temp directory -->
    <target name="init">
        <tstamp>
            <format property="backup.timestamp" pattern="yyyy-MM-dd_HH-mm-ss"/>
            <format property="backup.timestamp.readable" pattern="MMMM dd, yyyy 'at' hh:mm:ss a"/>
        </tstamp>
        
        <!-- Get hostname/device name -->
        <exec executable="hostname" outputproperty="device.hostname" failifexecutionfails="false"/>
        <property name="device.hostname" value="Unknown"/>
        
        <!-- Get OS name -->
        <property name="os.info" value="${os.name} ${os.version}"/>
        
        <!-- Get user name -->
        <property name="user.name.info" value="${user.name}"/>
        
        <!-- Define temp staging directory -->
        <property name="temp.staging.dir" location="${backup.destination.dir}/temp_backup_${backup.timestamp}"/>
        
        <echo message="========================================"/>
        <echo message="GIFT Data Backup Script"/>
        <echo message="========================================"/>
        <echo message="Timestamp: ${backup.timestamp}"/>
        <echo message="Device: ${device.hostname}"/>
        <echo message="Source: ${gift.base.dir}"/>
        <echo message="Destination: ${backup.destination.dir}"/>
        <echo message="========================================"/>
        <echo message=""/>
        
        <!-- Create backup directory if it doesn't exist -->
        <mkdir dir="${backup.destination.dir}"/>
        <!-- Create temp staging directory -->
        <mkdir dir="${temp.staging.dir}"/>
    </target>
    
    <!-- Copy folders to staging directory -->
    <target name="stage-folders" depends="init">
        <echo message="Preparing backup folders..."/>
        
        <!-- Check if data folder exists -->
        <available file="${gift.base.dir}/data" type="dir" property="data.folder.exists"/>
        <fail unless="data.folder.exists" message="ERROR: data folder not found at ${gift.base.dir}/data"/>
        
        <!-- Check if output folder exists -->
        <available file="${gift.base.dir}/output" type="dir" property="output.folder.exists"/>
        <fail unless="output.folder.exists" message="ERROR: output folder not found at ${gift.base.dir}/output"/>
        
        <!-- Copy data folder to staging -->
        <echo message="  Copying 'data' folder..."/>
        <copy todir="${temp.staging.dir}/data">
            <fileset dir="${gift.base.dir}/data"/>
        </copy>
        
        <!-- Copy output folder to staging -->
        <echo message="  Copying 'output' folder..."/>
        <copy todir="${temp.staging.dir}/output">
            <fileset dir="${gift.base.dir}/output"/>
        </copy>
        
        <echo message="Folders staged successfully"/>
        <echo message=""/>
    </target>
    
    <!-- Generate README file -->
    <target name="generate-readme" depends="stage-folders">
        <echo message="Generating README file..."/>
        
        <!-- Create README content -->
    <echo file="${temp.staging.dir}/README.txt">
        ========================================
            GIFT BACKUP INFORMATION
        ========================================

        Backup Created: ${backup.timestamp.readable}
        Backup Timestamp: ${backup.timestamp}

        ========================================
        SOURCE INFORMATION
        ========================================

        Device/Hostname: ${device.hostname}
        Operating System: ${os.info}
        User: ${user.name.info}

        Source Location: ${gift.base.dir}

        Folders Backed Up:
            - data/     (from ${gift.base.dir}/data)
            - output/   (from ${gift.base.dir}/output)

        ========================================
        BACKUP CONTENTS
        ========================================

        This backup contains two folders:

        1. data/
            Contains all data files from the GIFT system

        2. output/
            Contains all output files from the GIFT system

        ========================================
        RESTORATION INSTRUCTIONS
        ========================================

        To restore this backup:
            1. Extract this zip file to your desired location
            2. Copy the 'data' folder to: [YOUR_GIFT_INSTALLATION]/data
            3. Copy the 'output' folder to: [YOUR_GIFT_INSTALLATION]/output

    IMPORTANT: Make sure to backup any existing data before restoration!

    ========================================
    NOTES
    ========================================

    - This is an automated backup created by the GIFT backup script
    - Keep this backup in a safe location
    - For live testing, maintain multiple backup copies
    - Verify backup integrity before deleting source data

    ========================================
    </echo>
        <echo message=" README.txt generated successfully"/>
        <echo message=""/>
    </target>
    
    <!-- Create single zip file -->
    <target name="create-backup-zip" depends="generate-readme">
        <echo message="Creating backup archive..."/>
        
        <zip destfile="${backup.destination.dir}/GIFT_backup_${backup.timestamp}.zip"
             basedir="${temp.staging.dir}"
             compress="true"
             level="9"/>
        
        <echo message="Successfully created backup archive"/>
        <echo message="  File: GIFT_backup_${backup.timestamp}.zip"/>
        <length file="${backup.destination.dir}/GIFT_backup_${backup.timestamp}.zip" property="backup.zip.size"/>
        <echo message="  Size: ${backup.zip.size} bytes"/>
        <echo message=""/>
    </target>
    
    <!-- Clean up temporary staging directory -->
    <target name="cleanup" depends="create-backup-zip">
        <echo message="Cleaning up temporary files..."/>
        <delete dir="${temp.staging.dir}"/>
        <echo message="Cleanup complete"/>
        <echo message=""/>
    </target>
    
    <!-- Main backup target -->
    <target name="backup" depends="cleanup">
        <echo message="========================================"/>
        <echo message="Backup Complete!"/>
        <echo message="========================================"/>
        <echo message="Backup location: ${backup.destination.dir}"/>
        <echo message="Backup file: GIFT_backup_${backup.timestamp}.zip"/>
        <echo message=""/>
        <echo message="The zip file contains:"/>
        <echo message="  - README.txt (backup information)"/>
        <echo message="  - data/"/>
        <echo message="  - output/"/>
        <echo message=""/>
        <echo message="You can now copy the backup file to your pendrive."/>
        <echo message=""/>
    </target>
    
</project>
